# 텔레그램 봇 설정 (필수)
# 봇 생성: https://t.me/BotFather → /newbot
TELEGRAM_BOT_TOKEN=your_bot_token_here
# 채팅 ID: @userinfobot 에 메시지 보내서 확인
# 그룹 채널의 경우 -100XXXXXXXXXX 형식
TELEGRAM_CHAT_ID=your_chat_id_here

# MariaDB 설정 (2단계 이상)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=personnel_news
DB_USER=newsbot
DB_PASSWORD=newspass
DB_ROOT_PASSWORD=rootpass

# 크롤링 주기 (cron 형식)
# "*/1" = 매 1시간  |  "9,12,15,18" = 오전9시·오후12·3·6시
CRON_HOUR=*/1
CRON_MINUTE=0
